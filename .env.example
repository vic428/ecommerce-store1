# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env (local) or set in your host's environment settings (production).
# Never commit real values. See docs/ENVIRONMENT.md for what each one does.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres connection string. Each client deployment has its own database.
# Local: run `npm run db:dev` and paste the URL it prints.
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"
# Hosted databases are always encrypted. To also verify the server certificate (recommended
# for staging/production), paste the provider's CA certificate as PEM text (newlines as \n).
# Supabase: Project Settings → Database → SSL configuration → Download certificate.
# Required on Netlify production deploys (the app refuses to connect without it there).
# DATABASE_SSL_CA=""
# DATABASE_SSL_REQUIRE_CA="true"   # enforce verification in any other environment too
# DATABASE_SSL_CA="false"           # interim opt-out: encrypted but NOT verified (see SETUP.md)
# Max connections per server process. Set to 1 when using `npm run db:dev` (it only
# handles about one connection at a time). Leave unset for hosted Postgres.
# DATABASE_POOL_MAX="1"

# Public base URL of the storefront, no trailing slash. Used for links in emails,
# canonical URLs and payment-provider callbacks.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret used to sign CSRF/state tokens. 32+ random bytes, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ── Supabase (phase M2: auth + storage) ─────────────────────────────────────
# Separate values for staging and production. See SETUP.md.
# Supabase → Project Settings → API Keys. The JWKS URL is derived from SUPABASE_URL.
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY=""   # sb_publishable_… public by design; RLS blocks table access
SUPABASE_SECRET_KEY=""        # sb_secret_… SECRET, server only. Never NEXT_PUBLIC_, never in chat

# ── Payments (phase M4) ─────────────────────────────────────────────────────
# "mock" is a clearly-labelled test provider that never takes real money.
# Real providers are added under src/lib/payments/providers/ and enabled here
# and in /admin/settings → Payments.
PAYMENT_PROVIDER="mock"
# PAYMENT_SECRET_KEY=""        # provider secret key (server only)
# PAYMENT_PUBLIC_KEY=""        # provider publishable key, if the provider has one
# PAYMENT_WEBHOOK_SECRET=""    # used to verify webhook signatures

# ── Product image storage (phase M2) ────────────────────────────────────────
# "local" writes to public/uploads (development only). Staging/production will use
# Supabase Storage (set up in M2); the S3 variables remain for S3-compatible hosts.
STORAGE_DRIVER="local"
# S3_ENDPOINT=""
# S3_REGION=""
# S3_BUCKET=""
# S3_ACCESS_KEY_ID=""
# S3_SECRET_ACCESS_KEY=""
# S3_PUBLIC_BASE_URL=""

# ── Email (phase M3) ────────────────────────────────────────────────────────
# "console" prints emails to the server log (development only).
EMAIL_DRIVER="console"
# EMAIL_FROM="Store Name <orders@yourdomain.com>"
# RESEND_API_KEY=""
