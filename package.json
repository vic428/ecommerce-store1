{
  "name": "ecommerce-store1",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "postinstall": "prisma generate",
    "db:dev": "prisma dev --detach --name ecommerce-store1",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:studio": "prisma studio",
    "test:e2e": "playwright test",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:check-rls": "tsx scripts/check-rls.ts",
    "staff:create": "tsx scripts/create-staff.ts",
    "e2e:env": "tsx scripts/ensure-test-accounts-env.ts",
    "e2e:accounts": "npm run e2e:env && tsx scripts/create-staff.ts --email e2e-admin@example.com --role SUPER_ADMIN --name \"E2E Admin\" --password-env E2E_ADMIN_PASSWORD && tsx scripts/create-staff.ts --email e2e-customer@example.com --role CUSTOMER --name \"E2E Customer\" --password-env E2E_CUSTOMER_PASSWORD"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "lucide-react": "^1.81.0",
    "next": "16.4.6",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "simple-icons": "^16.38.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.10",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.1",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
